{
  "name": "@verifiably/refs",
  "version": "0.1.0",
  "description": "Vocabulary identifiers pinned to releases: the reference layer above nodes (TypeScript)",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "packageManager": "npm@11.11.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "data"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check ."
  },
  "dependencies": {
    "@verifiably/nodes": "file:../../nodes/ts",
    "canonicalize": "^3.0.0",
    "smol-toml": "1.9.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
