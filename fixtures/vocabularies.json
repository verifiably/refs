{
  "local_schemes": [
    {
      "prefix": "lit.topic-c",
      "name": "topic",
      "pattern": "^[A-Z]+$",
      "uri_format": null,
      "why": "a self-issued vocabulary for the vocabulary cases",
      "issued_by": "lit"
    }
  ],
  "accepted": [
    {
      "name": "the spec 5.4 example",
      "table": {
        "hgnc.symbol": {"issuer": "external", "release": "2026-07-01", "accepted": ["2026-04-01"]},
        "openalex.topic": {"issuer": "external", "release": "2026-06-26"},
        "lit.topic-c": {"issuer": "self", "release": "run:1"}
      },
      "expected": {
        "hgnc.symbol": {"issuer": "external", "release": "2026-07-01", "accepted": ["2026-04-01"]},
        "openalex.topic": {"issuer": "external", "release": "2026-06-26", "accepted": []},
        "lit.topic-c": {"issuer": "self", "release": "run:1", "accepted": []}
      }
    },
    {
      "name": "no declarations",
      "table": {},
      "expected": {}
    },
    {
      "name": "an empty accepted list",
      "table": {"hgnc.symbol": {"issuer": "external", "release": "a", "accepted": []}},
      "expected": {"hgnc.symbol": {"issuer": "external", "release": "a", "accepted": []}}
    },
    {
      "name": "accepted keeps its order",
      "table": {"hgnc.symbol": {"issuer": "external", "release": "c", "accepted": ["b", "a"]}},
      "expected": {"hgnc.symbol": {"issuer": "external", "release": "c", "accepted": ["b", "a"]}}
    },
    {
      "name": "a self-issued vocabulary with an accepted release",
      "table": {"lit.topic-c": {"issuer": "self", "release": "run:1", "accepted": ["run:0"]}},
      "expected": {"lit.topic-c": {"issuer": "self", "release": "run:1", "accepted": ["run:0"]}}
    },
    {
      "name": "a release that is not ASCII",
      "table": {"chebi": {"issuer": "external", "release": "Ａ", "accepted": ["𝟙"]}},
      "expected": {"chebi": {"issuer": "external", "release": "Ａ", "accepted": ["𝟙"]}}
    }
  ],
  "refused": [
    {"name": "an empty release", "table": {"hgnc.symbol": {"issuer": "external", "release": ""}}},
    {"name": "a numeric release", "table": {"hgnc.symbol": {"issuer": "external", "release": 1}}},
    {"name": "no release", "table": {"hgnc.symbol": {"issuer": "external"}}},
